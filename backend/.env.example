# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change_me_to_a_long_random_string

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://attendx:attendx@localhost:5432/attendx

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka (your existing Docker instance) ────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=attendx-gateway
KAFKA_GROUP_ID_GATEWAY=attendx-gateway-group

# ── Cloudinary (replace with your real credentials) ──────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AWS Rekognition (OPTIONAL — leave blank to use local face matching) ───────
# If both AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are set, the system
# uses AWS Rekognition for face search. Otherwise it falls back to local
# DeepFace-based comparison stored in PostgreSQL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_PREFIX=attendx-

# ── Face Matching ─────────────────────────────────────────────────────────────
# Confidence threshold (0–100). Matches below this go to "needs-review" (C9)
REKOGNITION_CONFIDENCE_THRESHOLD=80
# Max Rekognition calls per second — token bucket ceiling (C5)
REKOGNITION_RATE_PER_SEC=10
# Max DLQ retry attempts before routing to needs-review (C5)
MAX_DLQ_ATTEMPTS=5

# ── Session / Privacy ─────────────────────────────────────────────────────────
# Redis TTL for session keys in seconds. After expiry the TTL Reaper purges
# all images automatically (C7 — second purge mechanism)
SESSION_TTL_SECONDS=10800

# ── Python Face Worker (runs matcher_worker.py as FastAPI service) ────────────
FACE_WORKER_URL=http://localhost:8001
